# ==============================================================================
# SIGARI TRACK - Configurazione Variabili d'Ambiente
# ⚠️ ATTENZIONE: Genera password e token SENZA il carattere '$'
# Docker Compose interpreta il carattere '$' come variabile e lo sostituisce
# con una stringa vuota! Usa: openssl rand -hex 24
# ==============================================================================

# Database PostgreSQL (per stack Docker Compose)
POSTGRES_USER=tabacchi
POSTGRES_PASSWORD=tabacchi_secret_password_2026
POSTGRES_DB=tabacchi_prezzi

# Porta del server (default 3000)
PORT=3000
NODE_ENV=production

# Scraping automatico prezzi FIT (Federazione Italiana Tabaccai / ADM)
# Default cron: ogni lunedì alle 03:00 (0 3 * * 1)
SCRAPE_CRON="0 3 * * 1"
SCRAPE_ON_BOOT=true

# Token segreto per endpoint amministrativi (es. /api/admin/*)
ADMIN_TOKEN=sigari_admin_token_change_me_hex32

# Chiave per la firma dei token di sessione JWT
JWT_SECRET=sigari_jwt_secret_change_me_hex32

# Integrazione opzionale Home Assistant per temperature e umidità humidor
HA_API_KEY=

# Chiave API Gemini per recensioni organolettiche e note di degustazione
GEMINI_API_KEY=
